#!/usr/bin/env bash
# Pre-commit hook to enforce Ground Truth synchronization (S23 - LED-083)
set -euo pipefail

echo "==========================================================="
echo "🔄 Running auto-sync for ground-truth (Approach 1)..."
echo "==========================================================="

GENERATOR_SCRIPT="scripts/generators/build_ground_truth.py"
GROUND_TRUTH_DIR="ground-truth/"

if [ ! -f "$GENERATOR_SCRIPT" ]; then
    echo "❌ FATAL: $GENERATOR_SCRIPT not found. Cannot synchronize ground truth."
    exit 1
fi

PYTHON_BIN="$(which python3 || which python || true)"
if [ -z "$PYTHON_BIN" ]; then
    echo "❌ FATAL: python executable not found in PATH."
    exit 1
fi

# Run the generator fail-closed
"$PYTHON_BIN" "$GENERATOR_SCRIPT"

# Add the generated files to the commit
git add "$GROUND_TRUTH_DIR"

echo "✅ ground-truth successfully synced with the codebase."
exit 0
