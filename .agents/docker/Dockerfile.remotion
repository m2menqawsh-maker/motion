FROM node:20-bookworm

# Install required shared libraries for headless Chromium and FFmpeg, plus Arabic fonts
RUN apt-get update && apt-get install -y \
    chromium libnss3 libxss1 libasound2 libatk-bridge2.0-0 libgtk-3-0 \
    ffmpeg \
    fonts-noto-core fonts-arab \
    --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# Set env vars for puppeteer to use the installed chromium
ENV PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
