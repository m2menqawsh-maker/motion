{
  "id": "dynamic-montage-ad",
  "name": "Dynamic Montage Ad",
  "name_ar": "منتاج إعلاني ديناميكي",
  "version": "1.0.0",
  "description": "Professional 9:16 reel ad mixing motion graphics and fast montage. Voiceover-driven with camera-tracking text zoom, full-screen to square transitions, 8-10 scenes, word-level karaoke captions with emphasis markers, and strict brand color compliance.",
  "best_for": ["إعلانات ريلز احترافية", "منتاج سريع", "إعلانات منتجات", "إعلانات خدمات"],
  "routing_keywords": ["ريلز", "منتاج", "إعلان", "موشن جرافيك", "ريل", "منتاج إعلاني", "إعلان احترافي", "منتاج سريع", "ريلز إعلان", "montage ad", "dynamic ad", "reel ad"],
  "platforms": ["instagram", "tiktok", "youtube_shorts"],
  "duration_seconds": {"min": 30, "max": 60, "target": 45},
  "aspect_ratios": ["9:16"],
  "personality": "Energetic",
  "motion_taste_citation": "motion-personality.md:Energetic",
  "scenes_count": {"min": 8, "max": 10},
  "layout_variety": {
    "required": true,
    "description": "كل مشهد يجب أن يكون مختلفاً في التخطيط. ممنوع تكرار نفس التخطيط (نص فوق فيديو) في كل المشاهد.",
    "layouts": [
      "fullscreen_text",
      "fullscreen_video",
      "square_video_center",
      "text_over_video",
      "split_screen",
      "text_only_dark",
      "video_with_text_overlay",
      "fullscreen_motion_graphics"
    ]
  },
  "camera_tracking_text": {
    "required": true,
    "description": "النص يظهر وكأن الكاميرا تتبعه. لا يظهر من اتجاه واحد ثابت. الزوم قوي على الكلمات المهمة.",
    "zoom_strength": "strong",
    "zoom_on_keywords": true
  },
  "transitions": {
    "required": true,
    "types": [
      "fullscreen_to_square",
      "square_to_fullscreen",
      "whip_pan",
      "push_transition",
      "zoom_through",
      "clock_wipe",
      "cross_dissolve"
    ],
    "description": "انتقالات ديناميكية بين المشاهد. يجب أن يكون هناك على الأقل انتقال واحد من شاشة كاملة لمربع أو العكس."
  },
  "captions": {
    "style": "karaoke_word_level",
    "direction": "rtl",
    "emphasis_markers": true,
    "description": "كابشن كاريوكي كلمة-بكلمة، من اليمين لليسار، مع علامات تمييز على الكلمات المهمة (لون مختلف، حجم أكبر، أو توهج)."
  },
  "brand_colors": {
    "required": true,
    "description": "يجب تحديد لوحة ألوان العلامة التجارية والالتزام بها في كل المشاهد. ممنوع استخدام ألوان عشوائية."
  },
  "voiceover": {
    "source": "user_upload_or_elevenlabs",
    "description": "التعليق الصوتي هو الأساس. كل التوقيتات تُستخرج منه عبر analyze_voiceover."
  },
