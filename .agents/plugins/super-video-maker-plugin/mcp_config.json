{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "audio-tools-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/audio-tools-mcp",
        "run",
        "python",
        "server.py"
      ],
      "cwd": ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/audio-tools-mcp",
      "env": {}
    },
    "media-sources-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/media-sources-mcp",
        "run",
        "python",
        "server.py"
      ],
      "cwd": ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/media-sources-mcp",
      "env": {
        "SVM_DATA_DIR": ".",
        "SVM_PLUGIN_ROOT": ".agents/plugins/super-video-maker-plugin"
      }
    },
    "video-tools-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/video-tools-mcp",
        "run",
        "python",
        "server.py"
      ],
      "cwd": ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/video-tools-mcp",
      "env": {}
    },
    "image-tools-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/image-tools-mcp",
        "run",
        "python",
        "server.py"
      ],
      "cwd": ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/image-tools-mcp",
      "env": {}
    },
    "common-tools-mcp": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "--directory",
        ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/common-tools-mcp",
        "run",
        "python",
        "server.py"
      ],
      "cwd": ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/common-tools-mcp",
      "env": {
        "SVM_DATA_DIR": ".",
        "SVM_PLUGIN_ROOT": ".agents/plugins/super-video-maker-plugin"
      }
    },
    "ffmpeg-mcp-server": {
      "type": "stdio",
      "command": "node",
      "args": [
        "server.js"
      ],
      "cwd": ".agents/plugins/super-video-maker-plugin/tools/mcp-servers/ffmpeg-mcp-server",
      "env": {}
    }
  }
}
