{
  "additionalProperties": false,
  "description": "Immutable promotion snapshot binding candidate, approval, and target identity (S28-07E).\nFrozen before canonical publication begins.",
  "properties": {
    "approval_decision_id": {
      "description": "Identifier of authoritative human CandidateReviewDecision",
      "title": "Approval Decision Id",
      "type": "string"
    },
    "candidate_content_hash": {
      "description": "SHA-256 content hash of approved candidate",
      "title": "Candidate Content Hash",
      "type": "string"
    },
    "candidate_id": {
      "description": "Target candidate identifier",
      "title": "Candidate Id",
      "type": "string"
    },
    "candidate_revision": {
      "description": "Candidate CAS revision at promotion",
      "minimum": 1,
      "title": "Candidate Revision",
      "type": "integer"
    },
    "created_at": {
      "description": "UTC timestamp of manifest creation",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "promotion_id": {
      "description": "Unique promotion identifier (prom_{hex12})",
      "title": "Promotion Id",
      "type": "string"
    },
    "promotion_manifest_hash": {
      "description": "Deterministic SHA-256 digest of manifest",
      "title": "Promotion Manifest Hash",
      "type": "string"
    },
    "promotion_policy_version": {
      "default": "1.0.0",
      "description": "Promotion policy version",
      "title": "Promotion Policy Version",
      "type": "string"
    },
    "review_bundle_hash": {
      "description": "Digest of verified CandidateReviewBundle",
      "title": "Review Bundle Hash",
      "type": "string"
    },
    "review_bundle_id": {
      "description": "Identifier of verified CandidateReviewBundle",
      "title": "Review Bundle Id",
      "type": "string"
    },
    "runtime_validation_id": {
      "description": "ID of passing runtime validation report",
      "title": "Runtime Validation Id",
      "type": "string"
    },
    "schema_hash": {
      "description": "SHA-256 digest of template props schema",
      "title": "Schema Hash",
      "type": "string"
    },
    "source_code_hash": {
      "description": "SHA-256 digest of template source code",
      "title": "Source Code Hash",
      "type": "string"
    },
    "static_validation_id": {
      "description": "ID of passing static validation report",
      "title": "Static Validation Id",
      "type": "string"
    },
    "target_template_id": {
      "description": "Target canonical template ID (kebab-case)",
      "title": "Target Template Id",
      "type": "string"
    },
    "target_template_version": {
      "default": "1.0.0",
      "description": "Semantic version of target template",
      "title": "Target Template Version",
      "type": "string"
    },
    "workspace_id": {
      "default": "ws_default",
      "description": "Workspace identifier for multi-tenant isolation",
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "promotion_id",
    "candidate_id",
    "candidate_content_hash",
    "candidate_revision",
    "approval_decision_id",
    "review_bundle_id",
    "review_bundle_hash",
    "static_validation_id",
    "runtime_validation_id",
    "target_template_id",
    "source_code_hash",
    "schema_hash",
    "created_at",
    "promotion_manifest_hash"
  ],
  "title": "PromotionManifest",
  "type": "object"
}
