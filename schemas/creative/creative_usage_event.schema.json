{
  "$defs": {
    "CostProvenance": {
      "description": "Epistemic basis and certainty of a monetary cost figure.",
      "enum": [
        "ACTUAL",
        "ESTIMATED",
        "UNKNOWN"
      ],
      "title": "CostProvenance",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Canonical fine-grained consumption and telemetry event for Creative operations.\nCan be converted to/from canonical S27 TraceSpanRecord to prevent duplicate ledgers.",
  "properties": {
    "actual_cost": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Authoritative actual cost",
      "title": "Actual Cost"
    },
    "cache_hit": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Whether prompt cache was hit",
      "title": "Cache Hit"
    },
    "cached_input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Tokens read from prompt cache",
      "title": "Cached Input Tokens"
    },
    "cost_provenance": {
      "$ref": "#/$defs/CostProvenance",
      "default": "ESTIMATED",
      "description": "Basis of cost calculation"
    },
    "created_at": {
      "description": "UTC creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "description": "ISO 4217 currency code",
      "pattern": "^[A-Z]{3}$",
      "title": "Currency",
      "type": "string"
    },
    "details": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Sanitized non-sensitive diagnostic attributes",
      "title": "Details",
      "type": "object"
    },
    "estimated_cost": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "ge": "0"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Estimated monetary cost",
      "title": "Estimated Cost"
    },
    "event_id": {
      "description": "Unique usage event identifier",
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "generation_count": {
      "default": 0,
      "description": "Media or template generation count",
      "minimum": 0,
      "title": "Generation Count",
      "type": "integer"
    },
    "input_hash": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Deterministic hash of operational inputs for duplicate detection (no raw prompts)",
      "title": "Input Hash"
    },
    "input_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Input/prompt token count",
      "title": "Input Tokens"
    },
    "latency_ms": {
      "anyOf": [
        {
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Execution duration in milliseconds",
      "title": "Latency Ms"
    },
    "model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Underlying model identifier used",
      "title": "Model"
    },
    "operation_type": {
      "default": "AI_COMPLETION",
      "description": "Operational classification",
      "minLength": 1,
      "title": "Operation Type",
      "type": "string"
    },
    "output_tokens": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Output/completion token count",
      "title": "Output Tokens"
    },
    "pricing_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Model rate card / pricing version used",
      "title": "Pricing Version"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Associated project identifier",
      "title": "Project Id"
    },
    "provider": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Provider providing the capability (e.g. openai, gemini)",
      "title": "Provider"
    },
    "request_count": {
      "default": 1,
      "description": "Total API/RPC request count",
      "minimum": 0,
      "title": "Request Count",
      "type": "integer"
    },
    "retrieval_items": {
      "default": 0,
      "description": "Number of knowledge/asset/template items retrieved",
      "minimum": 0,
      "title": "Retrieval Items",
      "type": "integer"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Creative run or evaluation run identifier",
      "title": "Run Id"
    },
    "stage": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Creative pipeline stage (e.g. INTENT, PLANNING, RETRIEVAL)",
      "title": "Stage"
    },
    "subsystem": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Subsystem emitting telemetry (e.g. intent, narrative, style)",
      "title": "Subsystem"
    },
    "workspace_id": {
      "description": "Tenant workspace identifier",
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "workspace_id",
    "created_at"
  ],
  "title": "CreativeUsageEvent",
  "type": "object"
}
