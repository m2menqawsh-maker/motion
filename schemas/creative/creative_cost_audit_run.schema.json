{
  "$defs": {
    "EfficiencyFinding": {
      "additionalProperties": false,
      "description": "Non-mutating diagnostic finding identifying waste, drift, or excessive expenditure.",
      "properties": {
        "evidence_refs": {
          "description": "IDs of spans or events proving the issue",
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_bound": {
          "$ref": "#/$defs/JsonValue",
          "description": "Acceptable policy or baseline bound"
        },
        "finding_id": {
          "description": "Unique finding identifier",
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "finding_type": {
          "$ref": "#/$defs/EfficiencyFindingType",
          "description": "Classification of efficiency issue"
        },
        "observed_value": {
          "$ref": "#/$defs/JsonValue",
          "description": "Empirically measured metric or value"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Associated project identifier",
          "title": "Project Id"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Associated run identifier",
          "title": "Run Id"
        },
        "severity": {
          "$ref": "#/$defs/EfficiencySeverity",
          "description": "Severity impact level"
        },
        "summary": {
          "description": "Human-readable explanation of the finding",
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "workspace_id": {
          "description": "Tenant workspace identifier",
          "minLength": 1,
          "title": "Workspace Id",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "workspace_id",
        "finding_type",
        "severity",
        "observed_value",
        "expected_bound",
        "summary"
      ],
      "title": "EfficiencyFinding",
      "type": "object"
    },
    "EfficiencyFindingType": {
      "description": "Categories of detected waste or inefficiency in creative execution.",
      "enum": [
        "UNNECESSARY_PREMIUM_CALL",
        "DUPLICATE_PLANNING",
        "OVER_RETRIEVAL",
        "UNNECESSARY_GENERATION",
        "CREATE_ESCALATION_WITHOUT_REASON",
        "HIGH_COST_CALL_OBSERVED",
        "EXPENSIVE_REPEATED_FAILURE",
        "INCOMPLETE_COST_COVERAGE"
      ],
      "title": "EfficiencyFindingType",
      "type": "string"
    },
    "EfficiencySeverity": {
      "description": "Impact severity of an efficiency finding.",
      "enum": [
        "INFO",
        "WARNING",
        "CRITICAL"
      ],
      "title": "EfficiencySeverity",
      "type": "string"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Authoritative machine-readable report generated by the Creative Cost Audit CLI.",
  "properties": {
    "completed_at": {
      "description": "Audit completion timestamp",
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "cost_coverage_complete": {
      "default": true,
      "description": "Whether all audited events have known cost coverage",
      "title": "Cost Coverage Complete",
      "type": "boolean"
    },
    "cost_totals": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "System-wide aggregated cost totals",
      "title": "Cost Totals",
      "type": "object"
    },
    "findings": {
      "description": "All efficiency findings detected",
      "items": {
        "$ref": "#/$defs/EfficiencyFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "known_cost_event_count": {
      "default": 0,
      "description": "Total audited events with known cost provenance",
      "minimum": 0,
      "title": "Known Cost Event Count",
      "type": "integer"
    },
    "latency_summary": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Latency percentiles and totals",
      "title": "Latency Summary",
      "type": "object"
    },
    "policy_version": {
      "default": "S28-08C",
      "description": "Auditing policy version tag",
      "title": "Policy Version",
      "type": "string"
    },
    "projects_evaluated": {
      "default": 0,
      "description": "Total distinct projects audited",
      "minimum": 0,
      "title": "Projects Evaluated",
      "type": "integer"
    },
    "run_id": {
      "description": "Unique audit execution run identifier",
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "started_at": {
      "description": "Audit start timestamp",
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "tier_distribution": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "REUSE / COMPOSE / CREATE distributions",
      "title": "Tier Distribution",
      "type": "object"
    },
    "unknown_cost_event_count": {
      "default": 0,
      "description": "Total audited events with UNKNOWN cost provenance",
      "minimum": 0,
      "title": "Unknown Cost Event Count",
      "type": "integer"
    },
    "usage_totals": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "System-wide aggregated usage totals",
      "title": "Usage Totals",
      "type": "object"
    },
    "verdict": {
      "default": "PASS",
      "description": "Audit verdict (PASS, WARNING, FAIL)",
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "started_at",
    "completed_at"
  ],
  "title": "CreativeCostAuditRun",
  "type": "object"
}
