      "title": "CapabilityType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "An execution stage within a production recipe.",
  "properties": {
    "actions": {
      "description": "List of concrete actions performed in this stage",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "artifacts": {
      "description": "Expected deliverable artifact identifiers",
      "items": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "paid_generation": {
      "default": false,
      "description": "Flag indicating if stage consumes paid AI generation",
      "title": "Paid Generation",
      "type": "boolean"
    },
    "required_capabilities": {
      "description": "Provider-neutral capabilities needed for this stage",
      "items": {
        "$ref": "#/$defs/CapabilityType"
      },
      "title": "Required Capabilities",
      "type": "array"
    },
    "stage_id": {
      "description": "Stage identifier (e.g., 'stage_brief', 'stage_storyboard')",
      "title": "Stage Id",
      "type": "string"
    },
    "title": {
      "description": "Human-readable stage title",
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "stage_id",
    "title",
    "actions"
  ],
  "title": "RecipeStage",
  "type": "object"
}
