{
  "$defs": {
    "ArtifactRecord": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ValidationLevel"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "path",
        "validation"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "CheckpointStage": {
      "enum": [
        "INITIALIZED",
        "ASSETS_READY",
        "PLAN_READY",
        "BLUEPRINT_READY",
        "PROBE_READY",
        "APPROVED",
        "RENDERED",
        "QC_PASSED",
        "COMPLETE"
      ],
      "title": "CheckpointStage",
      "type": "string"
    },
    "GateEntry": {
      "properties": {
        "status": {
          "$ref": "#/$defs/GateStatus",
          "default": "locked"
        },
        "approved_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved By"
        },
        "approved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approved At"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "GateEntry",
      "type": "object"
    },
    "GateStatus": {
      "enum": [
        "locked",
        "awaiting",
        "approved",
        "rejected"
      ],
      "title": "GateStatus",
      "type": "string"
    },
    "StageEntry": {
      "properties": {
        "status": {
          "$ref": "#/$defs/StageStatus",
          "default": "pending"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        }
      },
      "title": "StageEntry",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "done",
        "failed"
      ],
      "title": "StageStatus",
      "type": "string"
    },
    "ValidationLevel": {
      "enum": [
        "EXISTS",
        "SIZE",
        "SHA256"
      ],
      "title": "ValidationLevel",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "current_stage": {
      "default": 0,
      "title": "Current Stage",
      "type": "integer"
    },
    "last_error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Error"
    },
    "stages": {
      "additionalProperties": {
        "$ref": "#/$defs/StageEntry"
      },
      "title": "Stages",
      "type": "object"
    },
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/GateEntry"
      },
      "title": "Gates",
      "type": "object"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Id"
    },
    "checkpoint": {
      "$ref": "#/$defs/CheckpointStage",
      "default": "INITIALIZED"
    },
    "artifact_references": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifact References",
      "type": "array"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "ProjectState",
  "type": "object"
}