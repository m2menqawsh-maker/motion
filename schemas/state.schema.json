{
  "$defs": {
    "ArtifactRecord": {
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ValidationLevel"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "logical_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logical Name"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "produced_at_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Produced At Revision"
        },
        "generation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Id"
        },
        "metadata": {
          "additionalProperties": true,
          "default": {},
          "title": "Metadata",
          "type": "object"
        },
        "status": {
          "default": "VALID",
          "enum": [
            "VALID",
            "INVALIDATED",
            "SUPERSEDED"
          ],
          "title": "Status",
          "type": "string"
        },
        "invalidated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated At"
        },
        "invalidated_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated Reason"
        },
        "invalidated_by_recovery_plan": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invalidated By Recovery Plan"
        }
      },
      "required": [
        "path",
        "validation"
      ],
      "title": "ArtifactRecord",
      "type": "object"
    },
    "EvidenceStatus": {
      "enum": [
        "VALID",
        "INVALIDATED",
        "SUPERSEDED"
      ],
      "title": "EvidenceStatus",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "DRAFT",
        "ASSETS_READY",
        "PLAN_READY",
        "BLUEPRINT_READY",
        "MATERIALIZED",
        "PROBE_PASSED",
        "AWAITING_REVIEW",
        "REVIEW_APPROVED",
        "RENDERED",
        "FINAL_QC_PASSED",
        "COMPLETE",
        "FAILED",
        "CANCELLED"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "ValidationLevel": {
      "enum": [
        "EXISTS",
        "SIZE",
        "SHA256"
      ],
      "title": "ValidationLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "revision": {
      "default": 1,
      "title": "Revision",
      "type": "integer"
    },
    "lifecycle_state": {
      "$ref": "#/$defs/LifecycleState",
      "default": "DRAFT"
    },
    "run_metadata": {
      "additionalProperties": true,
      "title": "Run Metadata",
      "type": "object"
    },
    "approval_metadata": {
      "additionalProperties": true,
      "title": "Approval Metadata",
      "type": "object"
    },
    "structured_errors": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Structured Errors",
      "type": "array"
    },
    "artifact_records": {
      "items": {
        "$ref": "#/$defs/ArtifactRecord"
      },
      "title": "Artifact Records",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "project_id"
  ],
  "title": "ProjectState",
  "type": "object"
}