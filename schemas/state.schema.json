{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "state.schema.json",
  "title": "حالة المشروع — Project State",
  "description": "عقد حالة المشروع: يتتبع المراحل والبوابات والحالة الحالية لخط الإنتاج",
  "type": "object",
  "required": ["project_id", "current_stage", "stages", "gates", "updated_at"],
  "additionalProperties": false,
  "definitions": {
    "stageEntry": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["pending", "running", "done", "failed"],
          "description": "حالة المرحلة"
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "وقت البدء"
        },
        "finished_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "وقت الانتهاء"
        }
      },
      "description": "سجل مرحلة واحدة"
    },
    "gateEntry": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["locked", "awaiting", "approved", "rejected"],
          "description": "حالة البوابة"
        },
        "approved_by": {
          "type": ["string", "null"],
          "description": "من وافق على البوابة"
        },
        "approved_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "وقت الموافقة"
        },
        "note": {
          "type": ["string", "null"],
          "description": "ملاحظة إضافية"
        }
      },
      "description": "سجل بوابة واحدة"
    }
  },
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^prj_[a-z0-9_-]+$",
      "description": "معرّف المشروع"
    },
    "current_stage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "المرحلة الحالية (0 إلى 3)"
    },
    "last_error": {
      "type": ["string", "null"],
      "description": "آخر خطأ مسجل (أو null)"
    },
    "stages": {
      "type": "object",
      "required": ["0", "1", "2", "3"],
      "additionalProperties": false,
      "properties": {
        "0": { "$ref": "#/definitions/stageEntry" },
        "1": { "$ref": "#/definitions/stageEntry" },
        "2": { "$ref": "#/definitions/stageEntry" },
        "3": { "$ref": "#/definitions/stageEntry" }
      },
      "description": "سجل المراحل الأربعة"
    },
    "gates": {
      "type": "object",
      "required": ["gate_1", "gate_2", "gate_3"],
      "additionalProperties": false,
      "properties": {
        "gate_1": { "$ref": "#/definitions/gateEntry" },
        "gate_2": { "$ref": "#/definitions/gateEntry" },
        "gate_3": { "$ref": "#/definitions/gateEntry" }
      },
      "description": "سجل بوابات الجودة الثلاث"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "تاريخ ووقت آخر تحديث"
    }
  }
}
