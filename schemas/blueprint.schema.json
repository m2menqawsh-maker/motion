{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "blueprint.schema.json",
  "title": "المخطط التنفيذي — Blueprint (مصدر الحقيقة الوحيد المولد آلياً من Zod)",
  "description": "عقد المخطط التنفيذي: يصف المشاهد والأنماط والحركات والأصوات — المصدر الوحيد للحقيقة لبناء الفيديو",
  "type": "object",
  "properties": {
    "blueprint_version": {
      "type": "string",
      "enum": [
        "2.0.0",
        "2.0"
      ]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_\\-]+$"
    },
    "fps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5",
        "21:9"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scene_id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_\\-]+$"
          },
          "template": {
            "type": "string",
            "minLength": 1
          },
          "startFrame": {
            "type": "integer",
            "minimum": 0
          },
          "durationFrames": {
            "type": "integer",
            "minimum": 1
          },
          "content": {
            "type": "object",
            "properties": {
              "lines": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "words": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "word": {
                      "type": "string"
                    },
                    "startMs": {
                      "type": "number",
                      "minimum": 0
                    },
                    "endMs": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "word",
                    "startMs",
                    "endMs"
                  ],
                  "additionalProperties": false
                }
              },
              "images": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "screen": {
                "type": "string"
              },
              "numbers": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "range": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "number"
                  },
                  "to": {
                    "type": "number"
                  }
                },
                "required": [
                  "from",
                  "to"
                ],
                "additionalProperties": false
              },
              "path": {
                "type": "string"
              },
              "icons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "audioRef": {
                "type": "string"
              },
              "spectrum": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "additionalProperties": false
          },
          "template_props": {
            "type": "object",
            "additionalProperties": {}
          },
          "props": {
            "type": "object",
            "additionalProperties": {}
          },
          "surface": {
            "type": "object",
            "additionalProperties": {}
          },
          "layout": {
            "type": "object",
            "properties": {
              "layer": {
                "type": "number",
                "minimum": 1,
                "maximum": 5
              },
              "coverage_pct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": false
          },
          "media_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sfx_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "captions_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "transition": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-zA-Z0-9_\\-]+$",
                "default": "fade"
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1,
                "default": 15
              },
              "timing": {
                "type": "string",
                "enum": [
                  "linear",
                  "ease-in-out"
                ]
              }
            },
            "additionalProperties": false
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "effect": {
                  "type": "string",
                  "minLength": 1
                },
                "apply": {
                  "type": "string",
                  "enum": [
                    "scene",
                    "overlay"
                  ],
                  "default": "scene"
                },
                "params": {
                  "type": "object",
                  "additionalProperties": {},
                  "default": {}
                }
              },
              "required": [
                "effect"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "scene_id",
          "template",
          "startFrame",
          "durationFrames"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "type": "object",
      "properties": {
        "voiceover": {
          "type": "object",
          "properties": {
            "asset_ref": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            },
            "startFrame": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "durationFrames": {
              "type": "integer",
              "minimum": 1
            },
            "mute": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "asset_ref"
          ],
          "additionalProperties": false
        },
        "music": {
          "type": "object",
          "properties": {
            "asset_ref": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
            },
            "volume": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.15
            },
            "startFrame": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "durationFrames": {
              "type": "integer",
              "minimum": 1
            },
            "loop": {
              "type": "boolean",
              "default": true
            },
            "mute": {
              "type": "boolean",
              "default": false
            },
            "ducking": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean",
                  "default": true
                },
                "ducking_volume": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1,
                  "default": 0.05
                },
                "duck_under": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "default": [
                    "voiceover"
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "asset_ref"
          ],
          "additionalProperties": false
        },
        "global_sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "asset_ref": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_\\-\\.]+$"
              },
              "startFrame": {
                "type": "integer",
                "minimum": 0,
                "default": 0
              },
              "durationFrames": {
                "type": "integer",
                "minimum": 1
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              }
            },
            "required": [
              "asset_ref"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "motion_personality": {
          "type": "string",
          "enum": [
            "Cinematic",
            "Energetic",
            "Playful",
            "Technical"
          ]
        },
        "timings_path": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "default": {}
    }
  },
  "required": [
    "blueprint_version",
    "project_id",
    "fps",
    "aspect_ratio",
    "scenes"
  ],
  "additionalProperties": false
}