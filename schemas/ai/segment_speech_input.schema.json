{
  "$defs": {
    "SpeechSegment": {
      "additionalProperties": false,
      "description": "Canonical speech utterance / sentence / subtitle segment.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Segment average confidence",
          "title": "Confidence"
        },
        "end": {
          "description": "Segment end timestamp in seconds relative to original asset start",
          "minimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Unique segment identifier",
          "title": "Id"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Segment language if distinct/code-switched",
          "title": "Language"
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Associated speaker identifier",
          "title": "Speaker Id"
        },
        "start": {
          "description": "Segment start timestamp in seconds relative to original asset start",
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "text": {
          "description": "Segment verbatim transcript text",
          "title": "Text",
          "type": "string"
        },
        "words": {
          "description": "Constituent aligned words if available",
          "items": {
            "$ref": "#/$defs/SpeechWord"
          },
          "title": "Words",
          "type": "array"
        }
      },
      "required": [
        "start",
        "end",
        "text"
      ],
      "title": "SpeechSegment",
      "type": "object"
    },
    "SpeechWord": {
      "additionalProperties": false,
      "description": "Canonical word-level timestamp and confidence alignment token.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Word-level recognition confidence",
          "title": "Confidence"
        },
        "end": {
          "description": "End timestamp in seconds relative to original asset start",
          "minimum": 0.0,
          "title": "End",
          "type": "number"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Token language if distinct from primary",
          "title": "Language"
        },
        "speaker_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Associated speaker identifier (e.g. 'SPEAKER_00')",
          "title": "Speaker Id"
        },
        "start": {
          "description": "Start timestamp in seconds relative to original asset start",
          "minimum": 0.0,
          "title": "Start",
          "type": "number"
        },
        "text": {
          "description": "Word verbatim text",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "start",
        "end"
      ],
      "title": "SpeechWord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Input contract for slicing speech audio into segments.",
  "properties": {
    "audio_storage_key": {
      "description": "StorageService key for source audio file",
      "minLength": 1,
      "title": "Audio Storage Key",
      "type": "string"
    },
    "max_duration_seconds": {
      "default": 7.0,
      "description": "Maximum duration per slice",
      "minimum": 1.0,
      "title": "Max Duration Seconds",
      "type": "number"
    },
    "min_duration_seconds": {
      "default": 1.0,
      "description": "Minimum duration per slice",
      "minimum": 0.1,
      "title": "Min Duration Seconds",
      "type": "number"
    },
    "project_id": {
      "description": "Project context identifier",
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "segments": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/SpeechSegment"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Pre-computed speech segments",
      "title": "Segments"
    }
  },
  "required": [
    "project_id",
    "audio_storage_key"
  ],
  "title": "SegmentSpeechInput",
  "type": "object"
}
