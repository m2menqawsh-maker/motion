{
  "$defs": {
    "AnalysisProvenance": {
      "additionalProperties": false,
      "description": "Authoritative audit record tracking the generator, model, version,\nconfidence, and execution timestamp of an intelligence result.",
      "properties": {
        "analysis_version": {
          "default": "1.0.0",
          "description": "Analysis schema and logic version",
          "title": "Analysis Version",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Confidence score bounded [0.0, 1.0]",
          "title": "Confidence"
        },
        "contract_version": {
          "default": "1.0.0",
          "description": "SemVer of canonical contract",
          "title": "Contract Version",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Specific model invoked (e.g. 'whisper-large-v3')",
          "title": "Model"
        },
        "producer": {
          "description": "Originating subsystem, service, or tool",
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider adapter identifier (e.g. 'local', 'whisper')",
          "title": "Provider"
        },
        "timestamp": {
          "description": "Timezone-aware timestamp of analysis execution",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provider or model engine version",
          "title": "Version"
        }
      },
      "required": [
        "producer",
        "timestamp"
      ],
      "title": "AnalysisProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical result for lip synchronization.",
  "properties": {
    "duration_seconds": {
      "description": "Output video duration",
      "minimum": 0.0,
      "title": "Duration Seconds",
      "type": "number"
    },
    "output_video_hash": {
      "description": "SHA-256 hash of output video",
      "minLength": 8,
      "title": "Output Video Hash",
      "type": "string"
    },
    "output_video_storage_key": {
      "description": "Abstract StorageService key for lip-synced video",
      "minLength": 1,
      "title": "Output Video Storage Key",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/AnalysisProvenance",
      "description": "Provenance audit record"
    },
    "sync_confidence": {
      "description": "Estimated audio-visual alignment confidence",
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Sync Confidence",
      "type": "number"
    }
  },
  "required": [
    "output_video_storage_key",
    "output_video_hash",
    "duration_seconds",
    "sync_confidence",
    "provenance"
  ],
  "title": "LipSyncResult",
  "type": "object"
}
