{
  "$defs": {
    "AIError": {
      "additionalProperties": false,
      "description": "Structured, client-safe error object emitted by the AI subsystem.\nExcludes sensitive infrastructure secrets and un-sanitized exception traces.",
      "properties": {
        "code": {
          "$ref": "#/$defs/AIErrorCode",
          "description": "Canonical machine-readable error code"
        },
        "dependency_reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional upstream dependency identifier associated with the failure",
          "title": "Dependency Reference"
        },
        "details": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Structured context details safe for client inspection",
          "title": "Details"
        },
        "message": {
          "description": "Sanitized client-safe error message",
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "description": "Whether the operation may succeed if retried",
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable"
      ],
      "title": "AIError",
      "type": "object"
    },
    "AIErrorCode": {
      "description": "Authoritative error classification for AI subsystem failures.",
      "enum": [
        "PROVIDER_UNAVAILABLE",
        "RATE_LIMITED",
        "TIMEOUT",
        "INVALID_MODEL_OUTPUT",
        "SCHEMA_VALIDATION_FAILED",
        "CAPABILITY_UNAVAILABLE",
        "BUDGET_EXCEEDED",
        "POLICY_DENIED",
        "TENANT_ACCESS_DENIED",
        "CONTENT_REJECTED",
        "DEPENDENCY_FAILED",
        "CANCELLED",
        "INTERNAL_ERROR"
      ],
      "title": "AIErrorCode",
      "type": "string"
    },
    "AIResponseStatus": {
      "description": "Canonical completion status of an AI subsystem response.",
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "AIResponseStatus",
      "type": "string"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "description": "Precision-safe monetary cost representation for budgeting and accounting.\nEnforces exact Decimal calculations to avoid binary floating-point drift.",
      "properties": {
        "actual_cost": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Final settled cost",
          "title": "Actual Cost"
        },
        "currency": {
          "default": "USD",
          "description": "ISO 4217 3-letter currency code (e.g. USD, EUR)",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "estimated_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Estimated cost prior to execution",
          "title": "Estimated Cost"
        },
        "pricing_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Identifier of the rate card or pricing matrix used",
          "title": "Pricing Version"
        },
        "reserved_cost": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Budget reserved during execution",
          "title": "Reserved Cost"
        }
      },
      "required": [
        "estimated_cost"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "JsonValue": {},
    "UsageRecord": {
      "additionalProperties": false,
      "description": "Canonical, provider-neutral resource consumption record.\nSupports LLMs, speech synthesis, vision processing, and generative media.",
      "properties": {
        "audio_seconds": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Duration of processed audio",
          "title": "Audio Seconds"
        },
        "image_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Count of images generated or analyzed",
          "title": "Image Count"
        },
        "input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of prompt/input tokens",
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Number of completion/output tokens",
          "title": "Output Tokens"
        },
        "reported_units": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/UsageUnitRecord"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional provider-reported auxiliary consumption units",
          "title": "Reported Units"
        },
        "total_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Total tokens consumed",
          "title": "Total Tokens"
        },
        "video_seconds": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Duration of processed video",
          "title": "Video Seconds"
        }
      },
      "title": "UsageRecord",
      "type": "object"
    },
    "UsageUnitRecord": {
      "additionalProperties": false,
      "description": "Auxiliary consumption metric for non-token modalities (e.g., characters, search calls).",
      "properties": {
        "quantity": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Measured consumption quantity",
          "title": "Quantity"
        },
        "unit_type": {
          "description": "Resource metric identifier",
          "minLength": 1,
          "title": "Unit Type",
          "type": "string"
        }
      },
      "required": [
        "unit_type",
        "quantity"
      ],
      "title": "UsageUnitRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Canonical response contract returned by the AI subsystem.\nContains structured output, standardized metrics, and optional diagnostic error.",
  "properties": {
    "contract_version": {
      "default": "1.0.0",
      "description": "SemVer version of this contract",
      "title": "Contract Version",
      "type": "string"
    },
    "cost": {
      "$ref": "#/$defs/CostEstimate",
      "description": "Monetary cost breakdown for this execution"
    },
    "created_at": {
      "description": "Timezone-aware response emission timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/AIError"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Structured error details if execution failed"
    },
    "request_id": {
      "description": "Identifier of the matching AIRequest",
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Structured normalized output payload on success",
      "title": "Result"
    },
    "run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Identifier of the background AIRun if applicable",
      "title": "Run Id"
    },
    "status": {
      "$ref": "#/$defs/AIResponseStatus",
      "description": "High-level completion status"
    },
    "usage": {
      "$ref": "#/$defs/UsageRecord",
      "description": "Normalized resource consumption"
    },
    "warnings": {
      "description": "Non-fatal warnings or policy advisories",
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "status",
    "cost",
    "created_at"
  ],
  "title": "AIResponse",
  "type": "object"
}
