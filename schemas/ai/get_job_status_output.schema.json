{
  "additionalProperties": false,
  "description": "Output contract for job execution state.",
  "properties": {
    "error": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Error message if job failed",
      "title": "Error"
    },
    "job_id": {
      "description": "Job execution identifier",
      "minLength": 1,
      "title": "Job Id",
      "type": "string"
    },
    "output_storage_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "StorageService key if job completed",
      "title": "Output Storage Key"
    },
    "progress_percent": {
      "default": 0.0,
      "description": "Execution progress percentage",
      "maximum": 100.0,
      "minimum": 0.0,
      "title": "Progress Percent",
      "type": "number"
    },
    "project_id": {
      "description": "Project context identifier",
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "status": {
      "description": "Job state (e.g. 'PENDING', 'RUNNING', 'COMPLETED', 'FAILED', 'CANCELLED')",
      "minLength": 1,
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "job_id",
    "status"
  ],
  "title": "GetJobStatusOutput",
  "type": "object"
}
