{
  "$defs": {
    "CapabilityType": {
      "description": "Authoritative, provider-neutral capability identifiers (ADR-004 DEC-06.3).\nVendor names (e.g. openai_*, elevenlabs_*, fal_*) are strictly forbidden.",
      "enum": [
        "TEXT_GENERATION",
        "REASONING",
        "PLANNING",
        "SUMMARIZATION",
        "TRANSLATION",
        "EMBEDDING",
        "MULTIMODAL_EMBEDDING",
        "SPEECH_TO_TEXT",
        "LANGUAGE_DETECTION",
        "DIARIZATION",
        "SPEECH_ALIGNMENT",
        "TEXT_TO_SPEECH",
        "AUDIO_DENOISE",
        "AUDIO_ENHANCE",
        "VOCAL_ISOLATION",
        "BEAT_DETECTION",
        "MUSIC_GENERATION",
        "VOICE_ANALYSIS",
        "VISION",
        "VIDEO_UNDERSTANDING",
        "OCR",
        "SHOT_DETECTION",
        "OBJECT_DETECTION",
        "PERSON_DETECTION",
        "SCENE_CLASSIFICATION",
        "CAPTIONING",
        "IMAGE_GENERATION",
        "VIDEO_GENERATION",
        "PERSON_SEGMENTATION",
        "BACKGROUND_REMOVAL",
        "LIP_SYNC",
        "UPSCALE",
        "TRIM_AUDIO",
        "EXTEND_AUDIO",
        "NORMALIZE_AUDIO_LOUDNESS",
        "NORMALIZE_AUDIO",
        "TRIM_AUDIO_SILENCE",
        "ANALYZE_LOUDNESS",
        "DETECT_SILENCE",
        "SEGMENT_SPEECH_AUDIO",
        "GENERATE_SPEECH_MANIFEST",
        "BUILD_SPEECH_TIMELINE",
        "SPLIT_SPEECH_TEXT",
        "PREPARE_VO_SEGMENTS",
        "ALIGN_AUDIO_METADATA",
        "TRIM_VIDEO",
        "EXTEND_VIDEO",
        "RESIZE_VIDEO",
        "TRIM_BLACK_FRAMES",
        "CHANGE_VIDEO_SPEED",
        "ENFORCE_KEYFRAME_INTERVAL",
        "CONCATENATE_VIDEOS",
        "PROBE_MEDIA",
        "TRANSCODE_VIDEO",
        "EXTRACT_AUDIO",
        "EXTRACT_FRAMES",
        "CONCAT_MEDIA",
        "CHANGE_CONTAINER",
        "NORMALIZE_MEDIA",
        "RESIZE_IMAGE",
        "CROP_IMAGE_TO_RATIO",
        "AUTO_CROP_IMAGE",
        "CONVERT_IMAGE",
        "OPTIMIZE_IMAGE",
        "PROBE_IMAGE",
        "PREPARE_IMAGE_ASSET",
        "THUMBNAIL",
        "DOWNLOAD_REMOTE_MEDIA",
        "EXTRACT_MEDIA_PAGE",
        "SEARCH_ICONS",
        "DOWNLOAD_ICON",
        "SEARCH_STOCK_IMAGES",
        "SEARCH_STOCK_VIDEOS",
        "SEARCH_STOCK_AUDIO",
        "SEARCH_SOUND_EFFECTS",
        "INSPECT_MEDIA",
        "MUTATE_ASSET_STATUS",
        "CHECK_MEDIA_CACHE",
        "STORE_MEDIA_CACHE",
        "GET_JOB_STATUS",
        "CANCEL_PROCESSING_JOB"
      ],
      "title": "CapabilityType",
      "type": "string"
    },
    "ExecutionClass": {
      "description": "Execution latency and scheduling tier for an AI workload.",
      "enum": [
        "INTERACTIVE",
        "BATCH",
        "BACKGROUND"
      ],
      "title": "ExecutionClass",
      "type": "string"
    },
    "JsonValue": {},
    "PrivacyRequirement": {
      "description": "Data privacy and retention requirements for external AI processing.",
      "enum": [
        "ZERO_DATA_RETENTION",
        "INTERNAL_ONLY",
        "PUBLIC_ALLOWED"
      ],
      "title": "PrivacyRequirement",
      "type": "string"
    },
    "QualityTarget": {
      "description": "Quality and resource allocation tier for model generation.",
      "enum": [
        "DRAFT",
        "STANDARD",
        "HIGH",
        "ULTRA"
      ],
      "title": "QualityTarget",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Canonical request contract for the AI subsystem.\nStandardized, provider-neutral representation of user or system intent.",
  "properties": {
    "actor_id": {
      "description": "Authenticated actor (user or service) identifier",
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "capability": {
      "$ref": "#/$defs/CapabilityType",
      "description": "Requested domain capability"
    },
    "contract_version": {
      "default": "1.0.0",
      "description": "SemVer version of this contract",
      "title": "Contract Version",
      "type": "string"
    },
    "created_at": {
      "description": "Timezone-aware request creation timestamp",
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_class": {
      "$ref": "#/$defs/ExecutionClass",
      "default": "INTERACTIVE",
      "description": "Execution latency and scheduling tier"
    },
    "input_data": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Structured typed payload providing inputs to the capability",
      "title": "Input Data",
      "type": "object"
    },
    "intent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional semantic intent or workflow action",
      "title": "Intent"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Constrained key-value metadata associated with the request",
      "title": "Metadata",
      "type": "object"
    },
    "privacy_requirement": {
      "$ref": "#/$defs/PrivacyRequirement",
      "default": "PUBLIC_ALLOWED",
      "description": "Data retention and isolation policy constraint"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional associated project identifier",
      "title": "Project Id"
    },
    "quality_target": {
      "$ref": "#/$defs/QualityTarget",
      "default": "STANDARD",
      "description": "Desired quality and resource allocation tier"
    },
    "request_id": {
      "description": "Unique client or system request identifier",
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional interactive session identifier",
      "title": "Session Id"
    },
    "workspace_id": {
      "description": "Mandatory tenant workspace identifier",
      "minLength": 1,
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "workspace_id",
    "actor_id",
    "capability",
    "created_at"
  ],
  "title": "AIRequest",
  "type": "object"
}
