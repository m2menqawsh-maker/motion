{
  "$defs": {
    "CapabilityType": {
      "description": "Authoritative, provider-neutral capability identifiers (ADR-004 DEC-06.3).\nVendor names (e.g. openai_*, elevenlabs_*, fal_*) are strictly forbidden.",
      "enum": [
        "TEXT_GENERATION",
        "REASONING",
        "PLANNING",
        "SUMMARIZATION",
        "TRANSLATION",
        "EMBEDDING",
        "MULTIMODAL_EMBEDDING",
        "SPEECH_TO_TEXT",
        "LANGUAGE_DETECTION",
        "DIARIZATION",
        "SPEECH_ALIGNMENT",
        "TEXT_TO_SPEECH",
        "AUDIO_DENOISE",
        "AUDIO_ENHANCE",
        "VOCAL_ISOLATION",
        "BEAT_DETECTION",
        "MUSIC_GENERATION",
        "VOICE_ANALYSIS",
        "VISION",
        "VIDEO_UNDERSTANDING",
        "OCR",
        "SHOT_DETECTION",
        "OBJECT_DETECTION",
        "PERSON_DETECTION",
        "SCENE_CLASSIFICATION",
        "CAPTIONING",
        "IMAGE_GENERATION",
        "VIDEO_GENERATION",
        "PERSON_SEGMENTATION",
        "BACKGROUND_REMOVAL",
        "LIP_SYNC",
        "UPSCALE",
        "TRIM_AUDIO",
        "EXTEND_AUDIO",
        "NORMALIZE_AUDIO_LOUDNESS",
        "TRIM_AUDIO_SILENCE",
        "SEGMENT_SPEECH_AUDIO",
        "GENERATE_SPEECH_MANIFEST",
        "BUILD_SPEECH_TIMELINE",
        "TRIM_VIDEO",
        "EXTEND_VIDEO",
        "RESIZE_VIDEO",
        "TRIM_BLACK_FRAMES",
        "CHANGE_VIDEO_SPEED",
        "ENFORCE_KEYFRAME_INTERVAL",
        "CONCATENATE_VIDEOS",
        "RESIZE_IMAGE",
        "CROP_IMAGE_TO_RATIO",
        "AUTO_CROP_IMAGE",
        "DOWNLOAD_REMOTE_MEDIA",
        "EXTRACT_MEDIA_PAGE",
        "SEARCH_ICONS",
        "DOWNLOAD_ICON",
        "SEARCH_STOCK_IMAGES",
        "SEARCH_STOCK_VIDEOS",
        "SEARCH_STOCK_AUDIO",
        "SEARCH_SOUND_EFFECTS",
        "INSPECT_MEDIA",
        "MUTATE_ASSET_STATUS",
        "CHECK_MEDIA_CACHE",
        "STORE_MEDIA_CACHE",
        "GET_JOB_STATUS",
        "CANCEL_PROCESSING_JOB"
      ],
      "title": "CapabilityType",
      "type": "string"
    },
    "EvalExample": {
      "additionalProperties": false,
      "description": "Individual test fixture or labeled example within an evaluation dataset.",
      "properties": {
        "example_id": {
          "description": "Unique example identifier within dataset",
          "minLength": 1,
          "title": "Example Id",
          "type": "string"
        },
        "expected_output": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected structured output",
          "title": "Expected Output"
        },
        "expected_schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Expected schema identifier or regex",
          "title": "Expected Schema"
        },
        "ground_truth_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human or verified label",
          "title": "Ground Truth Label"
        },
        "input_payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "description": "Structured input given to candidate",
          "title": "Input Payload",
          "type": "object"
        },
        "is_human_verified": {
          "default": false,
          "description": "Whether ground truth was created by human annotator",
          "title": "Is Human Verified",
          "type": "boolean"
        },
        "min_quality_score": {
          "default": 0.8,
          "description": "Minimum acceptable quality threshold",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Min Quality Score",
          "type": "number"
        }
      },
      "required": [
        "example_id",
        "input_payload"
      ],
      "title": "EvalExample",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "Authoritative evaluation dataset entity.",
  "properties": {
    "capability": {
      "$ref": "#/$defs/CapabilityType",
      "description": "Domain capability targeted by this dataset"
    },
    "content_hash": {
      "description": "Deterministic content hash of all examples",
      "minLength": 8,
      "title": "Content Hash",
      "type": "string"
    },
    "dataset_id": {
      "description": "Unique dataset identifier",
      "minLength": 1,
      "title": "Dataset Id",
      "type": "string"
    },
    "description": {
      "description": "Description of benchmark purpose",
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "examples": {
      "description": "Ordered test fixtures",
      "items": {
        "$ref": "#/$defs/EvalExample"
      },
      "minItems": 1,
      "title": "Examples",
      "type": "array"
    },
    "version": {
      "description": "Version string or SemVer",
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "version",
    "content_hash",
    "capability",
    "description",
    "examples"
  ],
  "title": "EvalDatasetContract",
  "type": "object"
}
