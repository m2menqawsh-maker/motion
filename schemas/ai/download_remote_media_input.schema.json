{
  "additionalProperties": false,
  "description": "Input contract for downloading remote media directly.",
  "properties": {
    "destination_asset_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional explicit asset identifier",
      "title": "Destination Asset Id"
    },
    "media_type": {
      "default": "video",
      "description": "Media kind ('video', 'image', 'audio')",
      "title": "Media Type",
      "type": "string"
    },
    "project_id": {
      "description": "Project context identifier",
      "minLength": 1,
      "title": "Project Id",
      "type": "string"
    },
    "url": {
      "description": "Remote media URL to download",
      "minLength": 1,
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "url"
  ],
  "title": "DownloadRemoteMediaInput",
  "type": "object"
}
