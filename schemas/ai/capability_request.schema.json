{
  "$defs": {
    "CapabilityType": {
      "description": "Authoritative, provider-neutral capability identifiers (ADR-004 DEC-06.3).\nVendor names (e.g. openai_*, elevenlabs_*, fal_*) are strictly forbidden.",
      "enum": [
        "TEXT_GENERATION",
        "REASONING",
        "PLANNING",
        "SUMMARIZATION",
        "TRANSLATION",
        "EMBEDDING",
        "MULTIMODAL_EMBEDDING",
        "SPEECH_TO_TEXT",
        "LANGUAGE_DETECTION",
        "DIARIZATION",
        "SPEECH_ALIGNMENT",
        "TEXT_TO_SPEECH",
        "AUDIO_DENOISE",
        "AUDIO_ENHANCE",
        "VOCAL_ISOLATION",
        "BEAT_DETECTION",
        "MUSIC_GENERATION",
        "VOICE_ANALYSIS",
        "VISION",
        "VIDEO_UNDERSTANDING",
        "OCR",
        "SHOT_DETECTION",
        "OBJECT_DETECTION",
        "PERSON_DETECTION",
        "SCENE_CLASSIFICATION",
        "CAPTIONING",
        "IMAGE_GENERATION",
        "VIDEO_GENERATION",
        "PERSON_SEGMENTATION",
        "BACKGROUND_REMOVAL",
        "LIP_SYNC",
        "UPSCALE",
        "TRIM_AUDIO",
        "EXTEND_AUDIO",
        "NORMALIZE_AUDIO_LOUDNESS",
        "TRIM_AUDIO_SILENCE",
        "SEGMENT_SPEECH_AUDIO",
        "GENERATE_SPEECH_MANIFEST",
        "BUILD_SPEECH_TIMELINE",
        "TRIM_VIDEO",
        "EXTEND_VIDEO",
        "RESIZE_VIDEO",
        "TRIM_BLACK_FRAMES",
        "CHANGE_VIDEO_SPEED",
        "ENFORCE_KEYFRAME_INTERVAL",
        "CONCATENATE_VIDEOS",
        "RESIZE_IMAGE",
        "CROP_IMAGE_TO_RATIO",
        "AUTO_CROP_IMAGE",
        "DOWNLOAD_REMOTE_MEDIA",
        "EXTRACT_MEDIA_PAGE",
        "SEARCH_ICONS",
        "DOWNLOAD_ICON",
        "SEARCH_STOCK_IMAGES",
        "SEARCH_STOCK_VIDEOS",
        "SEARCH_STOCK_AUDIO",
        "SEARCH_SOUND_EFFECTS",
        "INSPECT_MEDIA",
        "MUTATE_ASSET_STATUS",
        "CHECK_MEDIA_CACHE",
        "STORE_MEDIA_CACHE",
        "GET_JOB_STATUS",
        "CANCEL_PROCESSING_JOB"
      ],
      "title": "CapabilityType",
      "type": "string"
    },
    "CostEstimate": {
      "additionalProperties": false,
      "description": "Precision-safe monetary cost representation for budgeting and accounting.\nEnforces exact Decimal calculations to avoid binary floating-point drift.",
      "properties": {
        "actual_cost": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Final settled cost",
          "title": "Actual Cost"
        },
        "currency": {
          "default": "USD",
          "description": "ISO 4217 3-letter currency code (e.g. USD, EUR)",
          "pattern": "^[A-Z]{3}$",
          "title": "Currency",
          "type": "string"
        },
        "estimated_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "description": "Estimated cost prior to execution",
          "title": "Estimated Cost"
        },
        "pricing_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Identifier of the rate card or pricing matrix used",
          "title": "Pricing Version"
        },
        "reserved_cost": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                }
              ],
              "ge": "0"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Budget reserved during execution",
          "title": "Reserved Cost"
        }
      },
      "required": [
        "estimated_cost"
      ],
      "title": "CostEstimate",
      "type": "object"
    },
    "ExecutionClass": {
      "description": "Execution latency and scheduling tier for an AI workload.",
      "enum": [
        "INTERACTIVE",
        "BATCH",
        "BACKGROUND"
      ],
      "title": "ExecutionClass",
      "type": "string"
    },
    "JsonValue": {},
    "ModelRequirement": {
      "additionalProperties": false,
      "description": "Contract representing caller requirements and constraints for model resolution.\nUsed by future capability routers to score and select optimal deployments.",
      "properties": {
        "budget_constraint": {
          "anyOf": [
            {
              "$ref": "#/$defs/CostEstimate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Upper budget ceiling allowed for this operation"
        },
        "capability": {
          "$ref": "#/$defs/CapabilityType",
          "description": "Target capability required for execution"
        },
        "execution_class": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionClass"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Execution tier requirement (INTERACTIVE, BACKGROUND, BATCH)"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 639-1 language code or BCP 47 tag (e.g. 'en', 'ar')",
          "title": "Language"
        },
        "max_latency_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Maximum acceptable execution latency in milliseconds",
          "title": "Max Latency Ms"
        },
        "media_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MIME type of primary media input/output (e.g. 'audio/wav', 'image/png')",
          "title": "Media Type"
        },
        "privacy_requirement": {
          "$ref": "#/$defs/PrivacyRequirement",
          "default": "PUBLIC_ALLOWED",
          "description": "Data retention and isolation requirement"
        },
        "quality_target": {
          "$ref": "#/$defs/QualityTarget",
          "default": "STANDARD",
          "description": "Target quality tier"
        },
        "required_features": {
          "description": "List of feature tags required from candidate models (e.g. 'streaming', 'vision')",
          "items": {
            "type": "string"
          },
          "title": "Required Features",
          "type": "array"
        }
      },
      "required": [
        "capability"
      ],
      "title": "ModelRequirement",
      "type": "object"
    },
    "PrivacyRequirement": {
      "description": "Data privacy and retention requirements for external AI processing.",
      "enum": [
        "ZERO_DATA_RETENTION",
        "INTERNAL_ONLY",
        "PUBLIC_ALLOWED"
      ],
      "title": "PrivacyRequirement",
      "type": "string"
    },
    "QualityTarget": {
      "description": "Quality and resource allocation tier for model generation.",
      "enum": [
        "DRAFT",
        "STANDARD",
        "HIGH",
        "ULTRA"
      ],
      "title": "QualityTarget",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Provider-neutral request contract to invoke a domain capability (S28-M03).\nContains structured input arguments, tenant context, and execution constraints.\nForbidden from accepting implementation selection tokens (mcp_server, adapter_name, etc.).",
  "properties": {
    "actor_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Caller identity (user, service, or agent)",
      "title": "Actor Id"
    },
    "capability": {
      "anyOf": [
        {
          "$ref": "#/$defs/CapabilityType"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Alias for capability_id"
    },
    "capability_id": {
      "$ref": "#/$defs/CapabilityType",
      "description": "Canonical, provider-neutral capability identifier"
    },
    "capability_version": {
      "default": "1.0.0",
      "description": "SemVer version of this capability contract",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "title": "Capability Version",
      "type": "string"
    },
    "contract_version": {
      "default": "1.0.0",
      "description": "SemVer version of this contract",
      "title": "Contract Version",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Tracing and observability correlation identifier",
      "title": "Correlation Id"
    },
    "idempotency_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Client-supplied or caller idempotency key to prevent duplicate mutations",
      "title": "Idempotency Key"
    },
    "input": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Structured typed input payload for the capability",
      "title": "Input",
      "type": "object"
    },
    "input_data": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Backward-compatible alias for input",
      "title": "Input Data"
    },
    "metadata": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "Safe caller metadata",
      "title": "Metadata",
      "type": "object"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Project context identifier",
      "title": "Project Id"
    },
    "request_id": {
      "description": "Unique request identifier",
      "pattern": "^[a-zA-Z0-9_\\-]+$",
      "title": "Request Id",
      "type": "string"
    },
    "requested_timeout": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "maximum": 600.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Caller-requested timeout ceiling in seconds",
      "title": "Requested Timeout"
    },
    "requirements": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelRequirement"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional selection constraints for routing to MODEL category"
    },
    "tenant_context": {
      "anyOf": [
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Authoritative execution context reference or serializable claims",
      "title": "Tenant Context"
    },
    "workspace_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Workspace tenant boundary identifier",
      "title": "Workspace Id"
    }
  },
  "required": [
    "capability_id"
  ],
  "title": "CapabilityRequest",
  "type": "object"
}
