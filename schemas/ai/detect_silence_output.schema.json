      "minimum": 0.0,
      "title": "Silence Ratio",
      "type": "number"
    },
    "threshold_used_db": {
      "description": "Threshold used for detection",
      "title": "Threshold Used Db",
      "type": "number"
    },
    "total_silence_duration_seconds": {
      "description": "Total cumulative silence duration",
      "minimum": 0.0,
      "title": "Total Silence Duration Seconds",
      "type": "number"
    }
