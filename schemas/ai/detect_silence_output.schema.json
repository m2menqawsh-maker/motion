          "description": "Interval duration in seconds",
          "minimum": 0.0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "end_seconds": {
          "description": "Silence end timestamp in seconds",
          "minimum": 0.0,
          "title": "End Seconds",
          "type": "number"
        },
        "start_seconds": {
          "description": "Silence start timestamp in seconds",
          "minimum": 0.0,
          "title": "Start Seconds",
          "type": "number"
        }
      },
      "required": [
        "start_seconds",
        "end_seconds",
        "duration_seconds"
      ],
      "title": "SilenceIntervalItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Output contract for read-only silence detection.",
  "properties": {
    "audio_duration_seconds": {
      "description": "Total audio duration probed",
      "minimum": 0.0,
      "title": "Audio Duration Seconds",
      "type": "number"
    },
    "audio_storage_key": {
      "description": "StorageService key for source audio",
      "minLength": 1,
      "title": "Audio Storage Key",
      "type": "string"
    },
    "project_id": {
      "description": "Project context identifier",
      "minLength": 1,
      "title": "Project Id",
