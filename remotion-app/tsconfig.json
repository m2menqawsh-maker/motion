{
  "compilerOptions": {
    "target": "ES2018",
    "module": "ESNext",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    "typeRoots": [
      "./node_modules/@types",
      "../node_modules/@types"
    ],
    "baseUrl": ".",
    "paths": {
      "react": [
        "./node_modules/@types/react",
        "./node_modules/react",
        "../node_modules/@types/react",
        "../node_modules/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*",
        "./node_modules/react/*",
        "../node_modules/@types/react/*",
        "../node_modules/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom",
        "./node_modules/react-dom",
        "../node_modules/@types/react-dom",
        "../node_modules/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*",
        "./node_modules/react-dom/*",
        "../node_modules/@types/react-dom/*",
        "../node_modules/react-dom/*"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime",
        "./node_modules/react/jsx-runtime",
        "../node_modules/@types/react/jsx-runtime",
        "../node_modules/react/jsx-runtime"
      ],
      "@/*": [
        "src/*"
      ],
      "@registry/*": [
        "../registry/*"
      ],
      "@contracts/*": [
        "../contracts/*"
      ],
      "*": [
        "./node_modules/*",
        "../node_modules/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "src/engine/**/*",
    "src/templates/elements/data/StatCard.tsx"
  ]
}