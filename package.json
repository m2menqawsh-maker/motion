{
  "type": "module",
  "scripts": {
    "api:dev": "python -m uvicorn api.main:app --reload --port 8787",
    "studio": "remotion studio remotion-app/src/index.ts",
    "build": "remotion render remotion-app/src/index.ts BlueprintVideo out/video.mp4",
    "dev": "concurrently \"npm run api:dev\" \"npm run studio\"",
    "test": "vitest run --passWithNoTests",
    "test:contracts": "vitest run tests/contracts.test.ts"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.522",
    "@remotion/google-fonts": "^4.0.524",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "^4.0.524",
    "typescript": "^7.0.2",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "concurrently": "^10.0.5",
    "vitest": "^5.0.0"
  }
}
