<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128" width="128" height="128">
  <defs>
    <linearGradient id="screen-grad" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0%" stop-color="#0D1117"/>
      <stop offset="100%" stop-color="#161B22"/>
    </linearGradient>
    <filter id="glow-laptop" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="6" stdDeviation="8" flood-color="#58A6FF" flood-opacity="0.4"/>
    </filter>
  </defs>
  <circle cx="64" cy="64" r="54" fill="#0D131A" stroke="#58A6FF" stroke-width="2" opacity="0.8"/>
  <g filter="url(#glow-laptop)">
    <rect x="26" y="24" width="76" height="52" rx="6" fill="#21262D" stroke="#30363D" stroke-width="2"/>
    <rect x="30" y="28" width="68" height="44" rx="3" fill="url(#screen-grad)"/>
    <text x="36" y="39" fill="#FF7B72" font-family="monospace" font-size="7" font-weight="bold">def</text>
    <text x="52" y="39" fill="#D2A8FF" font-family="monospace" font-size="7">solve():</text>
    <text x="42" y="49" fill="#79C0FF" font-family="monospace" font-size="7">x = </text>
    <text x="58" y="49" fill="#FFA657" font-family="monospace" font-size="7">"Python"</text>
    <text x="42" y="59" fill="#7EE787" font-family="monospace" font-size="7">print(x)</text>
    <rect x="74" y="53" width="4" height="8" fill="#58A6FF"/>
    <path d="M 14 78 L 114 78 L 106 90 L 22 90 Z" fill="#30363D" stroke="#484F58" stroke-width="1.5"/>
    <rect x="52" y="80" width="24" height="4" rx="2" fill="#21262D"/>
  </g>
</svg>